# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Firebase Configuration
# Salin berkas kunci JSON kredensial Firebase Service Account ke folder root backend/ 
# dengan nama 'firebase-service-account.json'
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# AI Service Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000

